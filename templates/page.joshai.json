          "type": "custom-liquid",
          "settings": {
            "custom_liquid": "<section class=\"josh-ai-bottom-links\" style=\"padding:56px 0;background:#fff;\">\n  <div style=\"max-width:1180px;margin:0 auto;padding:0 24px;\">\n    <h2 style=\"margin:0 0 24px;font-size:clamp(2rem,4vw,3rem);line-height:1.1;color:#111820;\">Shop the products</h2>\n    <div style=\"display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;align-items:stretch;\">\n      <a href=\"https://konnected.io/products/smart-garage-door-opener-blaq-myq-alternative\" style=\"display:flex;flex-direction:column;gap:14px;min-height:100%;padding:20px;background:#fff;border:1px solid rgba(17,24,32,.12);border-radius:20px;text-decoration:none;color:#111820;box-shadow:0 12px 30px rgba(17,24,32,.08);\">\n        <span style=\"display:block;aspect-ratio:1 / 1;background:#fff;border-radius:16px;overflow:hidden;\">\n          <img src=\"https://cdn.shopify.com/s/files/1/2085/3145/files/MainImage-1.png?v=1712326207\" alt=\"Smart Garage Door Opener blaQ\" loading=\"lazy\" style=\"width:100%;height:100%;object-fit:contain;display:block;padding:16px;\">\n        </span>\n        <strong style=\"font-size:1.15rem;line-height:1.25;\">Smart Garage Door Opener - blaQ</strong>\n      </a>\n      <a href=\"https://konnected.io/products/smart-garage-door-opener\" style=\"display:flex;flex-direction:column;gap:14px;min-height:100%;padding:20px;background:#fff;border:1px solid rgba(17,24,32,.12);border-radius:20px;text-decoration:none;color:#111820;box-shadow:0 12px 30px rgba(17,24,32,.08);\">\n        <span style=\"display:block;aspect-ratio:1 / 1;background:#fff;border-radius:16px;overflow:hidden;\">\n          <img src=\"https://cdn.shopify.com/s/files/1/2085/3145/files/GDOWhite-MainImage.png?v=1717468898\" alt=\"Smart Garage Door Opener White v2\" loading=\"lazy\" style=\"width:100%;height:100%;object-fit:contain;display:block;padding:16px;\">\n        </span>\n        <strong style=\"font-size:1.15rem;line-height:1.25;\">GDO White v2</strong>\n      </a>\n      <aside style=\"display:flex;flex-direction:column;gap:14px;min-height:100%;padding:20px;background:#fff;border:1px solid rgba(17,24,32,.12);border-radius:20px;color:#111820;box-shadow:0 12px 30px rgba(17,24,32,.08);\">\n        <h3 style=\"margin:0;font-size:1.15rem;line-height:1.25;color:#111820;\">Helpful links</h3>\n        <div style=\"display:grid;gap:12px;\">\n          <a href=\"https://community.konnected.io/t/konnected-josh-ai-the-ultimate-privacy-first-smart-garage-experience/40252\" style=\"display:block;padding:14px 16px;border:1px solid rgba(17,24,32,.12);border-radius:12px;text-decoration:none;color:#111820;background:#fff;\">Konnected + Josh.ai community announcement</a>\n          <a href=\"https://www.josh.ai/devices\" style=\"display:block;padding:14px 16px;border:1px solid rgba(17,24,32,.12);border-radius:12px;text-decoration:none;color:#111820;background:#fff;\">Josh.ai supported devices</a>\n          <a href=\"https://konnected.io/collections/smart-garage-door-openers\" style=\"display:block;padding:14px 16px;border:1px solid rgba(17,24,32,.12);border-radius:12px;text-decoration:none;color:#111820;background:#fff;\">Konnected smart garage door openers</a>\n        </div>\n      </aside>\n    </div>\n  </div>\n  <style>@media (max-width:989px){.josh-ai-bottom-links div[style*=\"repeat(3\"]{grid-template-columns:1fr !important}.josh-ai-bottom-links{padding:40px 0 !important}}</style>\n</section>"
