t-weight: 400;\n}\n#shopify-section-{{ section.id }} .alexa-works-badge strong {\n  font-size: clamp(1.7rem, 2.75vw, 2.25rem);\n  font-weight: 700;\n  letter-spacing: 0;\n}\n@media (max-width: 749px) {\n  #shopify-section-{{ section.id }} .alexa-hero-lockup {\n    gap: 9px;\n    width: min(310px, 65vw);\n  }\n  #shopify-section-{{ section.id }} .alexa-hero-lockup__konnected {\n    width: min(300px, 100%);\n  }\n  #shopify-section-{{ section.id }} .alexa-works-badge {\n    gap: 10px;\n    min-height: 68px;\n    padding: 7px 14px;\n  }\n  #shopify-section-{{ section.id }} .alexa-works-badge__icon {\n    flex-basis: 58px;\n    width: 58px;\n    height: 58px;\n  }\n  #shopify-section-{{ section.id }} .alexa-works-badge__mark {\n    width: 58px;\n  }\n}\n{% endstyle %}"
