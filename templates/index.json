    "custom_what_lines": {
      "type": "custom-intro",
      "name": "Intro: smart home in your walls",
      "blocks": {
        "fit_1": {
          "type": "fit",
          "settings": {
            "question": "Just moved into a house with an old alarm system?",
            "answer": "Those wired sensors are faster and more reliable than anything in a retail kit. One board in the panel closet wakes up every one of them."
          }
        },
        "fit_2": {
          "type": "fit",
          "settings": {
            "question": "Paying monthly for a keypad you never touch?",
            "answer": "Keep the sensors, drop the contract. Arm, disarm, and get instant alerts from your phone, wherever you are."
          }
        },
        "fit_3": {
          "type": "fit",
          "settings": {
            "question": "Building on Home Assistant, SmartThings, Hubitat, or Alexa?",
            "answer": "Konnected is a first-class citizen: official integrations, local APIs, an optional cloud connector, and open-source firmware made with ESPHome. Konnected makes native integration a priority, so your smart home works the way you want it."
          }
        }
      },
      "block_order": [
        "fit_1",
        "fit_2",
        "fit_3"
      ],
      "settings": {
        "heading": "There’s a smart home hiding in your walls.",
        "lede": "That alarm panel in the closet already wires to every door, window, and motion sensor in the house. A Konnected board plugs in and hands every sensor to Home Assistant, SmartThings, Alexa, or whichever platform runs your home. <strong>No monthly fees</strong>, no rewiring, and most installs take <strong>about an hour</strong>.",
        "image": "shopify://shop_images/02166205cdfec617ba45c6979d68e164.png",
        "image_alt": "Cutaway view of a home with wired sensors marked at every door and window, the garage door, and a Konnected board installed in the existing alarm panel",
        "image_style": "illustration",
        "caption": "Every blue dot is a wired sensor most homes already have. One Konnected board brings them all online.",
        "flip": false,
        "section_width": "page-width",
        "padding-block-start": 64,
        "padding-block-end": 32
      }
    },
    "custom_intro_gdo": {
      "type": "custom-intro",
      "name": "Intro: garage door opener",
      "blocks": {
        "fit_1": {
          "type": "fit",
          "settings": {
            "question": "Ever driven off wondering if the door closed?",
            "answer": "Live status in your app, an alert the moment it opens, and a goodbye routine that closes it behind you."
          }
        },
        "fit_2": {
          "type": "fit",
          "settings": {
            "question": "Done fighting myQ and its disappearing features?",
            "answer": "GDO blaQ talks to your smart home directly and plugs into LiftMaster and Chamberlain garage openers by wire, bypassing the myQ cloud entirely."
          }
        },
        "fit_3": {
          "type": "fit",
          "settings": {
            "question": "Garage opener super old?",
            "answer": "GDO White hooks up to nearly any opener with a push-button wall switch and has a built-in laser sensor to detect whether the door is open or closed."
          }
        }
      },
      "block_order": [
        "fit_1",
        "fit_2",
        "fit_3"
      ],
      "settings": {
        "heading": "The biggest door in your house shouldn’t be the dumbest.",
        "lede": "A Konnected GDO hooks up to the garage door opener you already own and gives it live open and closed status, voice control, and automations in the same app as the rest of your home. GDO blaQ is <strong>the myQ alternative</strong>; GDO White is <strong>the universal option</strong>. Neither needs a subscription.",
        "image": "shopify://shop_images/Rectangle_585_2.jpg",
        "image_alt": "A Konnected garage door opener controller held between a thumb and forefinger",
        "image_style": "photo",
        "caption": "Just a few wires and some mounting strips or screws, and this little guy makes your garage door part of your smart home.",
        "flip": true,
        "section_width": "page-width",
        "padding-block-start": 32,
        "padding-block-end": 64
      }
    }
