{% doc %}
  Renders the temporary BFCM free-gift promotional banner.

  @param {image} background_image - Promotional artwork shown behind the banner copy.
  @param {string} heading - Banner heading.
  @param {string} [text] - Supporting rich text.
  @param {string} [button_label] - Call-to-action label.
  @param {string} [button_link] - Call-to-action destination.
  @param {string} [reminder] - Checkout reminder shown below the supporting text.
  @param {string} [image_loading] - Image loading behavior.
  @param {string} [image_fetchpriority] - Image fetch priority.
{% enddoc %}

<div class="k-sale-offers">
  {%- if background_image != blank -%}
    <div class="k-sale-offers__media" aria-hidden="true">
      {{
        background_image
        | image_url: width: 1600
        | image_tag:
          widths: '480, 720, 960, 1200, 1600',
          sizes: '(min-width: 750px) calc(100vw - 80px), calc(100vw - 32px)',
          loading: image_loading,
          fetchpriority: image_fetchpriority,
          alt: ''
      }}
    </div>
  {%- endif -%}

  <div class="k-sale-offers__intro">
    {%- if heading != blank -%}
      <h2 class="k-sale-offers__heading">{{ heading }}</h2>
    {%- endif -%}
    {%- if text != blank -%}
      <div class="k-sale-offers__text rte">{{ text }}</div>
    {%- endif -%}
    {%- if button_label != blank and button_link != blank -%}
      <a class="button" href="{{ button_link }}">{{ button_label }}</a>
    {%- endif -%}
    {%- if reminder != blank -%}
      <p class="k-sale-offers__reminder">{{ reminder }}</p>
    {%- endif -%}
  </div>
</div>
