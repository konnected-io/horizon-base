{% doc %}
Renders the BFCM free-gift threshold for eligible products.
{% enddoc %}

{% liquid
  assign gift_threshold = blank

  for variant in closest.product.variants
    case variant.sku
      when 'STOFF-MAG-4', 'SENSOR-VIP94-2-WHT', 'SENSOR-VIP94-2T-WHT', 'SENSOR-VIP100-WHT', 'SENSOR-VIP100-1-WHT'
        assign gift_threshold = '$150'
        break
      when 'SIREN-SD15W', 'USB-CONV-TYPEC-R', 'USB-CONV-MICRO-R', 'USB-CONV-MICRO-S', 'USB-CONV-F'
        if gift_threshold == blank or gift_threshold == '$250'
          assign gift_threshold = '$200'
        endif
      when 'SIREN-WAVE2', 'USB-CONV-PD-TYPEC-R', 'USB-CONV-PD-TYPEC-S', 'PIR-IS335'
        if gift_threshold == blank
          assign gift_threshold = '$250'
        endif
    endcase
  endfor
%}

{%- if gift_threshold != blank -%}
  <p class="k-free-gift-badge" {{ block.shopify_attributes }}>
    {{ 'products.product.free_gift_with_order' | t: amount: gift_threshold }}
  </p>
{%- endif -%}

{% schema %}
{
  "name": "Free gift badge",
  "settings": [],
  "presets": [
    {
      "name": "Free gift badge"
    }
  ]
}
{% endschema %}
