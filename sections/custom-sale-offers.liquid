<div class="section-background"></div>
<section
  id="{{ section.settings.anchor_id | escape }}"
  class="section section--{{ section.settings.section_width }} spacing-style"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div class="k-sale-offers">
    <div class="k-sale-offers__intro">
      {%- if section.settings.heading != blank -%}
        <h2 class="k-sale-offers__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="k-sale-offers__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.reminder != blank -%}
        <p class="k-sale-offers__reminder">{{ section.settings.reminder }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="k-sale-offers__tiers" role="list">
        {%- for block in section.blocks -%}
          <li class="k-sale-offers__tier" {{ block.shopify_attributes }}>
            <span class="k-sale-offers__threshold">{{ block.settings.threshold }}</span>
            <div>
              <h3 class="k-sale-offers__tier-title">{{ block.settings.title }}</h3>
              {%- if block.settings.text != blank -%}
                <p class="k-sale-offers__tier-text">{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Sale bonus offers",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "sale-bonus"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "More cart. More bonus."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Bonus choices unlock as your cart grows.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the sale"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "reminder",
      "label": "Cart reminder",
      "default": "Add an eligible bonus item to your cart before checkout. The discount applies automatically."
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "offer",
      "name": "Bonus tier",
      "settings": [
        {
          "type": "text",
          "id": "threshold",
          "label": "Threshold",
          "default": "$150+"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free bonus"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sale bonus offers",
      "blocks": [
        { "type": "offer" },
        { "type": "offer" },
        { "type": "offer" }
      ]
    }
  ]
}
{% endschema %}
