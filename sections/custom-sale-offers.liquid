{% liquid
  assign image_loading = 'lazy'
  assign image_fetchpriority = 'auto'

  if section.index <= 2
    assign image_loading = 'eager'
    assign image_fetchpriority = 'high'
  endif
%}

<div class="section-background"></div>
<section
  id="{{ section.settings.anchor_id | escape }}"
  class="section section--{{ section.settings.section_width }} spacing-style"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div class="k-sale-offers">
    {%- if section.settings.background_image != blank -%}
      <div class="k-sale-offers__media" aria-hidden="true">
        {{
          section.settings.background_image
          | image_url: width: 1600
          | image_tag:
            widths: '480, 720, 960, 1200, 1600',
            sizes: '(min-width: 990px) 960px, 100vw',
            loading: image_loading,
            fetchpriority: image_fetchpriority,
            alt: ''
        }}
      </div>
    {%- endif -%}

    <div class="k-sale-offers__intro">
      {%- if section.settings.heading != blank -%}
        <h2 class="k-sale-offers__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="k-sale-offers__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.reminder != blank -%}
        <p class="k-sale-offers__reminder">{{ section.settings.reminder }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sale gift banner",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "sale-gift"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Spend $150. Pick a free gift."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>More gift choices unlock at $200 and $250.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Choose a free gift"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "reminder",
      "label": "Cart reminder",
      "default": "Add your choice to cart before checkout. The discount applies automatically."
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Sale gift banner"
    }
  ]
}
{% endschema %}
