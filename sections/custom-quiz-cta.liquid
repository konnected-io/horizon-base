{%- comment -%}
  2026 refresh quiz banner (k-quiz): heading, text, and Okendo quiz buttons.
  Each button block opens one Okendo quiz by ID. Konnected-owned section;
  styles live in assets/custom.css.
{%- endcomment -%}

<div class="section-background"></div>
<div
  class="section section--{{ section.settings.section_width }} spacing-style"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div class="k-quiz k-reveal">
    {%- if section.settings.heading != blank -%}
      <h2 class="k-quiz__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="k-quiz__sub">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="k-quiz__actions">
        {%- for block in section.blocks -%}
          {%- if block.settings.quiz_id != blank -%}
            <div
              class="okeQuizModalButton{% if block.settings.style == 'secondary' %} okeQuizModalButton--ghost{% endif %}"
              style="display:flex;"
              {{ block.shopify_attributes }}
            >
              <button
                type="button"
                class="button"
                onclick="okeConnectApi.showQuiz({{ block.settings.quiz_id | strip | json | escape }}, {{ section.settings.okendo_subscriber_id | strip | json | escape }})"
              >
                {{ block.settings.label }}
              </button>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Quiz banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Not sure which product is right for you?"
    },
    { "type": "textarea", "id": "text", "label": "Text" },
    {
      "type": "text",
      "id": "okendo_subscriber_id",
      "label": "Okendo subscriber ID",
      "default": "1d0a586e-45b1-4a7e-b30d-539e2e1abc0e"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "quiz_button",
      "name": "Quiz button",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Take the quiz" },
        {
          "type": "text",
          "id": "quiz_id",
          "label": "Okendo quiz ID",
          "info": "From the Okendo admin, e.g. 7f8f415c-2756-4637-8119-aa24df66b6b7"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "primary", "label": "Primary" },
            { "value": "secondary", "label": "Secondary (outline)" }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Quiz banner",
      "blocks": [{ "type": "quiz_button" }]
    }
  ]
}
{% endschema %}
