{%- comment -%}
  2026 refresh hero (k-hero). Konnected-owned section; styles live in
  assets/custom.css under "2026 visual refresh: k-* components".

  Two shapes from one schema:
  - Homepage: h2 headline + sub, a proof column (rating, rotating quote blocks,
    badge blocks), then product-line card blocks.
  - Collection: breadcrumbs + h1 headline + sub, then kit-chooser card blocks
    with an optional "Best for..." fit line.
  The proof column only renders when the section has quote or badge blocks.
{%- endcomment -%}

{% liquid
  assign heading_tag = section.settings.heading_tag
  if heading_tag == 'h1'
    assign card_heading_tag = 'h2'
  else
    assign card_heading_tag = 'h3'
  endif

  assign quote_blocks = section.blocks | where: 'type', 'quote'
  assign badge_blocks = section.blocks | where: 'type', 'badge'
  assign card_blocks = section.blocks | where: 'type', 'card'
  assign has_proof = false
  if quote_blocks.size > 0 or badge_blocks.size > 0
    assign has_proof = true
  endif

  assign crumb_title = page.title
  assign crumb_url = page.url
  if collection
    assign crumb_title = collection.title
    assign crumb_url = collection.url
  endif
%}

<div class="section-background"></div>
<div
  class="section section--{{ section.settings.section_width }} spacing-style"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div class="k-hero{% if has_proof == false %} k-hero--collection{% endif %}">
    {%- capture intro -%}
      <div class="k-hero__intro">
        {%- if section.settings.show_breadcrumbs and crumb_title != blank -%}
          <nav class="k-crumbs" aria-label="{{ 'accessibility.breadcrumb' | t }}">
            <a href="{{ routes.root_url }}">{{ 'accessibility.breadcrumb_home' | t }}</a>
            <span class="k-crumbs__sep" aria-hidden="true">&rsaquo;</span>
            <span aria-current="page">{{ crumb_title }}</span>
          </nav>
          <script type="application/ld+json">
            {
              "@context": "https://schema.org",
              "@type": "BreadcrumbList",
              "itemListElement": [
                {"@type": "ListItem", "position": 1, "name": {{ 'accessibility.breadcrumb_home' | t | json }}, "item": {{ request.origin | append: routes.root_url | json }}},
                {"@type": "ListItem", "position": 2, "name": {{ crumb_title | json }}, "item": {{ request.origin | append: crumb_url | json }}}
              ]
            }
          </script>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <{{ heading_tag }} class="k-hero__title">{{ section.settings.heading }}</{{ heading_tag }}>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="k-hero__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endcapture -%}

    {%- if has_proof -%}
      <div class="k-hero__head">
        {{ intro }}
        <aside class="k-hero__proof">
          {%- if section.settings.rating_label != blank -%}
            <p class="k-hero__stars" role="img" aria-label="{{ section.settings.rating_label | escape }}">
              &#9733;&#9733;&#9733;&#9733;&#9733;
            </p>
          {%- endif -%}
          {%- if quote_blocks.size > 0 -%}
            <div class="k-quote-rotator">
              {%- for block in quote_blocks -%}
                <figure class="k-quote{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
                  <blockquote>&ldquo;{{ block.settings.quote }}&rdquo;</blockquote>
                  {%- if block.settings.author != blank -%}
                    <figcaption>{{ block.settings.author }}</figcaption>
                  {%- endif -%}
                </figure>
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- if badge_blocks.size > 0 -%}
            <div class="k-hero__badges">
              {%- for block in badge_blocks -%}
                {%- if block.settings.image != blank -%}
                  {%- liquid
                    assign badge_alt = block.settings.image.alt
                    if block.settings.alt != blank
                      assign badge_alt = block.settings.alt
                    endif
                  -%}
                  {{
                    block.settings.image
                    | image_url: width: 400
                    | image_tag: alt: badge_alt, loading: 'lazy', widths: '200, 400', sizes: '200px'
                  }}
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </aside>
      </div>
    {%- else -%}
      {{ intro }}
    {%- endif -%}

    {%- if card_blocks.size > 0 -%}
      <div class="k-hero__duo">
        {%- for block in card_blocks -%}
          {%- liquid
            assign card = block.settings
            assign card_alt = card.image.alt
            if card.image_alt != blank
              assign card_alt = card.image_alt
            endif
            assign img_class = 'k-line-card__img'
            if card.image_size == 'compact'
              assign img_class = 'k-line-card__img k-line-card__img--alarm'
            endif
          -%}
          <article class="k-line-card k-reveal" {{ block.shopify_attributes }}>
            {%- if card.image != blank -%}
              {%- capture card_img -%}
                {{
                  card.image
                  | image_url: width: 900
                  | image_tag:
                    alt: card_alt,
                    class: img_class,
                    widths: '450, 900, 1350',
                    sizes: '(min-width: 900px) 520px, 90vw',
                    fetchpriority: 'high',
                    loading: 'eager'
                }}
              {%- endcapture -%}
              {%- if card.link != blank -%}
                <a class="k-line-card__media-link" href="{{ card.link }}" tabindex="-1" aria-hidden="true">
                  {{- card_img -}}
                </a>
              {%- else -%}
                {{ card_img }}
              {%- endif -%}
            {%- endif -%}
            {%- if card.fit != blank -%}
              <p class="k-line-card__fit">{{ card.fit }}</p>
            {%- endif -%}
            <{{ card_heading_tag }} class="k-line-card__title">{{ card.title }}</{{ card_heading_tag }}>
            {%- if card.text != blank -%}
              <p class="k-line-card__text">{{ card.text }}</p>
            {%- endif -%}
            <div class="k-line-card__row">
              {%- if card.button_label != blank and card.link != blank -%}
                <a class="button" href="{{ card.link }}">{{ card.button_label }}</a>
              {%- endif -%}
              {%- if card.note != blank -%}
                <span class="k-line-card__note">{{ card.note }}</span>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero: product chooser",
  "settings": [
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "info": "Use H1 on collection pages, where this is the page title.",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": false
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Italic text renders as the brand-blue accent.",
      "default": "Breathe new life into the wiring your home <em>already has</em>."
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "rating_label",
      "label": "Star rating label",
      "info": "Read by screen readers for the five-star row above the quotes. Leave blank to hide the stars.",
      "default": "Rated 5 out of 5 stars"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Product card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text",
          "info": "Overrides the alt text saved with the file."
        },
        {
          "type": "select",
          "id": "image_size",
          "label": "Image size",
          "options": [
            { "value": "default", "label": "Default" },
            { "value": "compact", "label": "Compact" }
          ],
          "default": "default"
        },
        {
          "type": "text",
          "id": "fit",
          "label": "Fit label",
          "info": "Optional blue line above the title, e.g. \"Best for replacing your old panel\"."
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Product line" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "note", "label": "Note beside button" }
      ]
    },
    {
      "type": "quote",
      "name": "Customer quote",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "info": "Quotation marks are added automatically." },
        { "type": "text", "id": "author", "label": "Attribution", "default": "Verified customer" }
      ]
    },
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Alt text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero: product chooser",
      "blocks": [
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
