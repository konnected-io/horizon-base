{%- comment -%}
  2026 refresh product-line intro (k-intro): headline + lede, one media
  column with a caption, and "who is this for" question rows (fit blocks).
  Konnected-owned section; styles live in assets/custom.css.
{%- endcomment -%}

{% liquid
  assign image = section.settings.image
  assign image_alt = image.alt
  if section.settings.image_alt != blank
    assign image_alt = section.settings.image_alt
  endif
  assign img_class = 'k-intro__img'
  if section.settings.image_style == 'photo'
    assign img_class = 'k-intro__img k-intro__img--photo'
  endif
%}

<div class="section-background"></div>
<div
  class="section section--{{ section.settings.section_width }} spacing-style"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div class="k-intro{% if section.settings.flip %} k-intro--flip{% endif %}">
    <div class="k-intro__head k-reveal">
      {%- if section.settings.heading != blank -%}
        <h2 class="k-intro__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.lede != blank -%}
        <p class="k-intro__lede">{{ section.settings.lede }}</p>
      {%- endif -%}
    </div>

    {%- if image != blank -%}
      <div class="k-intro__media k-reveal">
        {{
          image
          | image_url: width: 1200
          | image_tag:
            alt: image_alt,
            class: img_class,
            widths: '600, 900, 1200',
            sizes: '(min-width: 900px) 560px, 90vw',
            loading: 'lazy'
        }}
        {%- if section.settings.caption != blank -%}
          <p class="k-intro__caption">{{ section.settings.caption }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="k-intro__fits" role="list">
        {%- for block in section.blocks -%}
          <li class="k-intro__fit k-reveal" {{ block.shopify_attributes }}>
            <h3 class="k-intro__q">{{ block.settings.question }}</h3>
            {%- if block.settings.answer != blank -%}
              <p class="k-intro__a">{{ block.settings.answer }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Intro: product line",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "There’s a smart home hiding in your walls."
    },
    {
      "type": "inline_richtext",
      "id": "lede",
      "label": "Intro text"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "info": "Overrides the alt text saved with the file."
    },
    {
      "type": "select",
      "id": "image_style",
      "label": "Image style",
      "options": [
        { "value": "illustration", "label": "Illustration (no frame)" },
        { "value": "photo", "label": "Photo (rounded frame)" }
      ],
      "default": "illustration"
    },
    { "type": "text", "id": "caption", "label": "Image caption" },
    {
      "type": "checkbox",
      "id": "flip",
      "label": "Image on the right",
      "default": false
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "fit",
      "name": "Who it's for",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Is this for you?" },
        { "type": "textarea", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Intro: product line",
      "blocks": [{ "type": "fit" }, { "type": "fit" }, { "type": "fit" }]
    }
  ]
}
{% endschema %}
